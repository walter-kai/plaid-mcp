PLAID_CLIENT_ID=
PLAID_SECRET=
# sandbox | development | production
PLAID_ENV=production

# Must match an Allowed redirect URI in the Plaid Dashboard exactly (no query params).
# For local + ngrok, use your current ngrok host.
PLAID_REDIRECT_URI=https://YOUR-NGROK-HOST.ngrok-free.app/oauth-redirect
PLAID_COMPLETION_URI=https://YOUR-NGROK-HOST.ngrok-free.app/link-complete
PLAID_WEBHOOK_URI=https://YOUR-NGROK-HOST.ngrok-free.app/webhook

# Public base URL Claude/Google OAuth see (ngrok URL when tunneling, else localhost).
PUBLIC_BASE_URL=https://YOUR-NGROK-HOST.ngrok-free.app

# Google OAuth Web client (Firebase/GCP project) — required for HTTP MCP.
# Authorized redirect URI must be: {PUBLIC_BASE_URL}/auth/callback
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Optional: restrict which Google accounts can call tools (comma-separated).
ALLOWED_EMAILS=

# Optional: stable key for MCP token signing (random string). Auto-ephemeral if unset.
# JWT_SIGNING_KEY=

# Optional: override where access tokens are stored (default: data/items.json).
# PLAID_ITEMS_PATH=data/items.json

# FastAPI bind (ngrok should point here).
PLAID_WEB_HOST=0.0.0.0
PLAID_WEB_PORT=3000
