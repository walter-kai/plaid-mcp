PLAID_CLIENT_ID=
PLAID_SECRET=
# sandbox | development | production
PLAID_ENV=production

# Must match an Allowed redirect URI in the Plaid Dashboard exactly (no query params).
# Spearfresh: https://spearfresh-link-….run.app/oauth-redirect
# Walt Yao:   https://waltyao.com/oauth-redirect
PLAID_REDIRECT_URI=https://YOUR-SERVICE.run.app/oauth-redirect

# Hosted Link post-completion landing page.
PLAID_COMPLETION_URI=https://YOUR-SERVICE.run.app/link-complete

# Webhook for SESSION_FINISHED (public_token delivery).
PLAID_WEBHOOK_URI=https://YOUR-SERVICE.run.app/webhook

# Optional: override where access tokens are stored locally (default: data/items.json).
# PLAID_ITEMS_PATH=data/items.json

# Cloud Run: persist Items in GCS instead of the container filesystem.
# Spearfresh and Walt Yao must use different object paths.
# PLAID_ITEMS_GCS_URI=gs://YOUR_BUCKET/plaid-mcp/items.json
# PLAID_ITEMS_GCS_URI=gs://YOUR_BUCKET/waltyao-plaid/items.json

# 32-byte AES-256-GCM key (base64 or hex) for encrypting Item access tokens at rest.
# Required when PLAID_ENV=production. Generate: openssl rand -base64 32
# PLAID_TOKEN_ENCRYPTION_KEY=

# Shared secret for spearfresh-ui server calling /api/v1/* (not for Claude, not public).
# Required in production. Leave unset for open local API during desktop testing.
# PLAID_SERVICE_KEY=

# Optional public base URL (documentation / deploy scripts).
# PUBLIC_BASE_URL=https://YOUR-SERVICE.run.app

# FastAPI bind (local). Cloud Run uses PORT automatically.
PLAID_WEB_HOST=0.0.0.0
PLAID_WEB_PORT=3000

# api | link | all (local default = all)
# PLAID_APP_MODE=all
